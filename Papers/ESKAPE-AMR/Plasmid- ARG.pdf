                           <pdfaType:namespaceURI>http://ns.useplus.org/ldf/xmp/1.0/</pdfaType:namespaceURI>
                           <pdfaType:prefix>plus</pdfaType:prefix>
                           <pdfaType:type>ImageCreatorDetail</pdfaType:type>
