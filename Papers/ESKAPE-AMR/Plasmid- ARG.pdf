                           <pdfaProperty:valueType>Seq CopyrightOwnerDetail</pdfaProperty:valueType>
                        </rdf:li>
                        <rdf:li rdf:parseType="Resource">
                           <pdfaProperty:category>external</pdfaProperty:category>
                           <pdfaProperty:description>Creator/s of the image.</pdfaProperty:description>
